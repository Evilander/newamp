  "dependencies": {
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.12.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "io.newamp.player",
    "productName": "NewAmp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/logo.png",
      "build/logo-app.webp",
      "build/icon.png",
      "build/icon.ico",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.png",
          "logo.png",
          "logo-app.webp"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "afterPack": "scripts/afterpack-verify-ffmpeg-arch.mjs",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "NewAmp ${version} ${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "NewAmp ${version} ${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "newamp",
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NewAmp Linux ${version} ${arch}.${ext}"
    },
    "portable": {
      "artifactName": "NewAmp Portable ${version}.${ext}",
      "unpackDirName": false
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "ogg",
          "oga",
          "opus",
          "wav",
          "m4a",
          "aac",
          "wma",
          "aiff",
          "aif",
          "ape",
          "wv",
          "mpc",
          "tta",
          "mka",
          "ac3",
          "dts",
          "dsf",
          "dff"
        ],
        "name": "NewAmp.AudioFile",
        "description": "NewAmp audio file",
        "role": "Viewer"
      },
      {
        "ext": [
          "m3u",
          "m3u8",
          "pls",
          "cue"
        ],
        "name": "NewAmp.PlaylistFile",
        "description": "NewAmp playlist or CUE sheet",
        "role": "Viewer"
      }
    ]
  }
}
