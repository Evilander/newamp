{
  "name": "newamp",
  "version": "1.0.0",
  "description": "A Winamp-inspired modern music player. Your local library, your rules, no streaming required.",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "author": "evilander",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k -n vite,electron -c blue,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "build": "tsc -p electron/tsconfig.json && node scripts/vite-build.mjs",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:vite": "node scripts/vite-build.mjs",
    "preview": "vite preview",
    "smoke:build-lock": "node scripts/build-lock-smoke.mjs",
    "smoke:library": "npm run build:electron && node scripts/library-smoke.mjs",
    "smoke:album-art": "npm run build:electron && node scripts/album-art-smoke.mjs",
    "smoke:full-library": "npm run build:electron && node scripts/full-library-smoke.mjs",
    "smoke:startup": "npm run build && cross-env NEWAMP_STARTUP_SMOKE=1 electron .",
    "smoke:playback": "npm run build:electron && electron scripts/playback-smoke-app",
    "smoke:transcode": "npm run build:electron && node scripts/transcode-smoke.mjs",
    "smoke:visualizer": "node scripts/visualizer-smoke.mjs",
    "smoke:tabs": "npm run build:electron && node scripts/tabs-smoke.mjs",
    "smoke:live-services": "npm run build:electron && node scripts/live-services-readiness-smoke.mjs",
    "smoke:artist": "node scripts/artist-surface-smoke.mjs",
    "smoke:podcast": "npm run build:electron && node scripts/podcast-smoke.mjs",
    "smoke:podcast-progress": "npm run build:electron && node scripts/podcast-progress-smoke.mjs",
    "smoke:podcast-download": "npm run build:electron && node scripts/podcast-download-smoke.mjs",
    "smoke:playlist": "npm run build:electron && node scripts/playlist-smoke.mjs",
    "smoke:incremental-scan": "npm run build:electron && node scripts/incremental-scan-smoke.mjs",
    "smoke:scanner-queue": "npm run build:electron && node scripts/scanner-queue-smoke.mjs",
    "smoke:library-paging": "npm run build:electron && node scripts/library-paging-smoke.mjs",
    "smoke:home": "npm run build:electron && node scripts/home-smoke.mjs",
    "smoke:folders": "npm run build:electron && node scripts/folder-browser-smoke.mjs",
    "smoke:quick-play": "npm run build:electron && node scripts/quick-play-smoke.mjs",
    "smoke:lastfm": "npm run build:electron && node scripts/lastfm-smoke.mjs",
    "smoke:replaygain": "npm run build:electron && node scripts/replaygain-smoke.mjs",
    "smoke:session": "npm run build:electron && node scripts/session-smoke.mjs",
    "smoke:chrome-state": "npm run build:electron && node scripts/chrome-state-smoke.mjs",
    "smoke:skin": "npm run build:electron && node scripts/skin-smoke.mjs",
    "smoke:smart": "npm run build:electron && node scripts/smart-rules-smoke.mjs",
    "smoke:suggested-stations": "npm run build:electron && node scripts/suggested-stations-smoke.mjs",
    "smoke:harmonic": "npm run build:electron && node scripts/harmonic-mix-smoke.mjs",
    "smoke:mixes": "npm run build:electron && node scripts/mixes-smoke.mjs",
    "smoke:auto-dj": "npm run build:electron && node scripts/auto-dj-smoke.mjs",
    "smoke:queue-edit": "npm run build:electron && node scripts/queue-edit-smoke.mjs",
    "smoke:queue-insert": "npm run build:electron && node scripts/queue-insert-smoke.mjs",
    "smoke:handoff": "npm run build:electron && node scripts/playback-handoff-smoke.mjs",
    "smoke:playback-start": "npm run build:electron && node scripts/playback-start-smoke.mjs",
    "smoke:playback-controls": "npm run build:electron && node scripts/playback-controls-smoke.mjs",
    "smoke:keyboard": "npm run build:electron && node scripts/keyboard-shortcuts-smoke.mjs",
    "smoke:media-session": "npm run build:electron && node scripts/media-session-smoke.mjs",
    "smoke:smart-shuffle": "npm run build:electron && node scripts/smart-shuffle-smoke.mjs",
    "smoke:metadata": "npm run build:electron && node scripts/metadata-rescue-smoke.mjs",
    "smoke:open-files": "npm run build:electron && node scripts/open-files-smoke.mjs",
    "smoke:health": "npm run build:electron && node scripts/library-health-smoke.mjs",
    "smoke:history": "npm run build:electron && node scripts/history-smoke.mjs",
    "smoke:search": "npm run build:electron && node scripts/power-search-smoke.mjs",
    "smoke:bookmarks": "npm run build:electron && node scripts/bookmarks-smoke.mjs",
    "smoke:practice-loop": "npm run build:electron && node scripts/practice-loop-smoke.mjs",
    "smoke:tempo": "npm run build:electron && node scripts/tempo-trainer-smoke.mjs",
    "smoke:audio-proof": "node scripts/audio-proof-smoke.mjs",
    "smoke:audio-output": "npm run build:electron && node scripts/audio-output-smoke.mjs",
    "smoke:audio-hardware": "node scripts/audio-hardware-readiness-smoke.mjs",
    "smoke:manual-listening-proof": "node scripts/manual-listening-proof-smoke.mjs",
    "smoke:eq": "npm run build:electron && node scripts/eq-smoke.mjs",
    "smoke:audio-limiter": "npm run build:electron && node scripts/audio-limiter-smoke.mjs",
    "smoke:rating": "npm run build:electron && node scripts/rating-smoke.mjs",
    "smoke:library-watch": "npm run build:electron && node scripts/library-watch-smoke.mjs",
    "smoke:library-prune": "npm run build:electron && node scripts/library-prune-smoke.mjs",
    "smoke:security": "node scripts/security-smoke.mjs",
    "smoke:signing-readiness": "node scripts/signing-readiness-smoke.mjs",
    "smoke:signing-workflow": "node scripts/signing-workflow-smoke.mjs",
    "smoke:release-checksums": "node scripts/release-checksums.mjs --check",
    "smoke:publish-github": "node scripts/publish-github-smoke.mjs",
    "smoke:reliability": "npm run build:electron && node scripts/reliability-smoke.mjs",
    "smoke:support-backup": "npm run build:electron && node scripts/support-backup-smoke.mjs",
    "smoke:support-restore": "npm run build:electron && node scripts/support-restore-smoke.mjs",
    "smoke:ui-playback": "npm run build && node scripts/ui-playback-smoke.mjs",
    "smoke:ui-quick-play": "npm run build && node scripts/ui-quick-play-smoke.mjs",
    "smoke:ui-visualizer": "npm run build && node scripts/ui-visualizer-smoke.mjs",
    "smoke:installer-artifact": "node scripts/installer-artifact-smoke.mjs",
    "smoke:installed-associations": "node scripts/installed-associations-smoke.mjs",
    "smoke:installed-app": "node scripts/installed-app-smoke.mjs",
    "smoke:packaged-open-files": "node scripts/packaged-open-files-smoke.mjs",
    "smoke:portable-app": "node scripts/portable-app-smoke.mjs",
    "smoke:ui-handoff": "npm run build && node scripts/ui-handoff-smoke.mjs",
    "smoke:ui-gapless": "npm run build && node scripts/ui-gapless-smoke.mjs",
    "smoke:ui-lyrics": "npm run build && node scripts/ui-lyrics-smoke.mjs",
    "smoke:local-lyrics": "npm run build:electron && node scripts/local-lyrics-smoke.mjs",
    "smoke:ui-local-lyrics": "npm run build && node scripts/ui-local-lyrics-smoke.mjs",
    "start": "npm run build && electron .",
    "generate:icon": "node scripts/generate-icon.mjs",
    "electron:install": "node scripts/install-electron.mjs",
    "postinstall": "node scripts/install-electron.mjs",
    "package": "node scripts/generate-icon.mjs && node scripts/package.mjs",
    "package:installer": "node scripts/generate-icon.mjs && node scripts/package.mjs --installer",
    "package:portable": "node scripts/generate-icon.mjs && node scripts/package.mjs --portable",
    "release:sign": "node scripts/sign-artifacts.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "release:publication-readiness": "node scripts/publication-readiness.mjs",
    "release:publish-github": "node scripts/publish-github-release.mjs",
    "release:check-listening-proof": "node scripts/manual-listening-proof.mjs --check",
    "release:record-listening-proof": "node scripts/manual-listening-proof.mjs --record",
    "release:gate": "node scripts/release-gate.mjs",
    "release:gate:local": "node scripts/release-gate.mjs --allow-unsigned --ack-manual --real-library"
  },
  "dependencies": {
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.12.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.eveland.newamp",
    "productName": "Newamp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Newamp Portable ${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "ogg",
          "oga",
          "opus",
          "wav",
          "m4a",
          "aac",
          "wma",
          "aiff",
          "aif",
          "ape",
          "wv",
          "mpc",
          "tta",
          "mka",
          "ac3",
          "dts",
          "dsf"
        ],
        "name": "Newamp.AudioFile",
        "description": "Newamp audio file",
        "role": "Viewer"
      },
      {
        "ext": [
          "m3u",
          "m3u8",
          "pls"
        ],
        "name": "Newamp.PlaylistFile",
        "description": "Newamp playlist",
        "role": "Viewer"
      }
    ]
  }
}
